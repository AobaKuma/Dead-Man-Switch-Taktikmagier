			<cooldownTime>5400</cooldownTime>
		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>Defs/VEF.Abilities.AbilityDef[defName="DMST_EmpBurst"]/modExtensions/li[@Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"]/psyfocusCost</xpath>
		<value>
			<psyfocusCost>0.07</psyfocusCost>
		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>Defs/VEF.Abilities.AbilityDef[defName="DMST_EmpBurst"]/modExtensions/li[@Class="VanillaPsycastsExpanded.AbilityExtension_Psycast"]/entropyGain</xpath>
