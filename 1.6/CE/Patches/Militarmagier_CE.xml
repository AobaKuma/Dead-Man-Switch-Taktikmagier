		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>Defs/VEF.Abilities.AbilityDef[defName="DMST_Repel"]/modExtensions/li[@Class="VEF.Abilities.AbilityExtension_Explosion"]/explosionRadius</xpath>
		<value>
			<explosionRadius>8</explosionRadius>
		</value>
</Operation>

<Operation Class="PatchOperationReplace">
		<xpath>Defs/VEF.Abilities.AbilityDef[defName="DMST_Swap"]/range</xpath>
