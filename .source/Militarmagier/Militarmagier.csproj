<Project Sdk="Microsoft.NET.Sdk">

  <!--
    只建置 RimWorld 1.7（.NET 10 / Waylith）→ 1.7/Assemblies，與 DMS 2 一致。
    1.7 沒有參考組件套件，直接參考遊戲本體的 DLL；預設假設本模組位於 <RimWorld>/Mods/<模組>/，
    遊戲裝在別處時以 -p:RimWorldDir=<遊戲目錄>\ 覆寫。不再參考 VPE／VEF。
    Builds RimWorld 1.7 only (.NET 10 / Waylith) into 1.7/Assemblies, matching DMS 2.
    1.7 has no reference-assembly package, so the game's own DLLs are referenced; override the game path
    with -p:RimWorldDir=<game dir>\ when the mod is not under <RimWorld>/Mods/<mod>/. VPE and VEF are no
    longer referenced.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Militarmagier</RootNamespace>
    <AssemblyName>Militarmagier</AssemblyName>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>10.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs 已提供組件屬性。Properties/AssemblyInfo.cs already supplies the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <!-- 遊戲只載入 Assemblies 內的 .dll，不需要 deps.json。The game only loads the .dll, so no deps.json. -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <RimWorldDir Condition="'$(RimWorldDir)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</RimWorldDir>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\1.7\Assemblies\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 與 Harmony 模組 1.7 資料夾內的 0Harmony.dll 相同版本（做法同 FFF）。Same version as the Harmony mod's 1.7 0Harmony.dll (as FFF does). -->
    <PackageReference Include="Lib.Harmony" Version="3.0.0-rc.2" ExcludeAssets="runtime" />
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldDir)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- 1.7 的 UnityEngine.* 型別全部由 UnityStubs 提供。In 1.7 every UnityEngine.* type comes from UnityStubs. -->
    <Reference Include="UnityStubs">
      <HintPath>$(RimWorldDir)UnityStubs.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Waylith">
      <HintPath>$(RimWorldDir)Waylith.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Fortified">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\_Fortified-Framework\1.7\Assemblies\Fortified.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
